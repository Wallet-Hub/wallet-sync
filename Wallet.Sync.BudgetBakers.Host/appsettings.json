{
  "Logging": {
    "LogLevel": {
      "Default": "None",
      "Wallet.Sync": "Information"
    }
  },
  "FileSystemSecrets": {
    "Path": "C:\\code\\secrets\\Wallet.Sync.BudgetBakers.Host.secrets.json"
  },
  "BudgetBakers": {
    "AccessToken": ""
  },
  "AccountFilter": {
    "PageLength": 10
  },
  "CategoryFilter": {
    "PageLength": 30
  },
  "RecordFilter": {
    "PageLength": 30,
    "MinimumDate": "2026-01-01",
    "MaximumDate": "2026-12-31"
  },
  "ConnectionStrings": {
    "WalletSync": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Wallet.Sync": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "MyConsoleApp"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\code\\logs\\Wallet.Sync.BudgetBakers.Host-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 31,
          "shared": false,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}